#!/bin/sh /etc/rc.common
# OpenWrt procd init script for meshd.

USE_PROCD=1
START=95
STOP=10

start_service() {
	config_load meshd

	local role http_addr mgmt_addr mesh_addr database_path udp_listen home_id home_name controller_id
	local auto_adopt controller_url identity_dir serial backhaul_iface led_enabled led_name auto_onboard_wired
	local manage_network uplink_port lan_device onboard_grace mesh_ssid mesh_key

	config_get role main role controller
	# When http_addr is set, meshd serves both planes on it (combined mode).
	# Clear it (remove the option) to run split listeners: mgmt_addr (admin/UI)
	# and mesh_addr (node-to-node control plane).
	config_get http_addr main http_addr ""
	config_get mgmt_addr main mgmt_addr 127.0.0.1:8080
	config_get mesh_addr main mesh_addr 0.0.0.0:8081
	config_get database_path main database_path /etc/meshd/meshd.bolt
	config_get udp_listen main udp_listen :45678
	config_get home_id main home_id ""
	config_get home_name main home_name Home
	config_get controller_id main controller_id gw01
	config_get mesh_ssid main mesh_ssid ""
	config_get mesh_key main mesh_key ""
	config_get auto_adopt main auto_adopt 0
	config_get controller_url main controller_url ""
	config_get identity_dir main identity_dir /etc/meshd/identity
	config_get serial main serial ""
	config_get backhaul_iface main backhaul_iface ""
	config_get led_enabled main led_enabled 1
	config_get led_name main led_name green:status
	config_get auto_onboard_wired main auto_onboard_wired 0
	config_get onboard_grace main onboard_grace 20s
	config_get manage_network main manage_network 0
	config_get uplink_port main uplink_port ""
	config_get lan_device main lan_device "@device[0]"

	procd_open_instance
	procd_set_param command /usr/bin/meshd
	procd_set_param env \
		MESHD_ROLE="$role" \
		MESHD_HTTP_ADDR="$http_addr" \
		MESHD_MGMT_ADDR="$mgmt_addr" \
		MESHD_MESH_ADDR="$mesh_addr" \
		MESHD_DATABASE_PATH="$database_path" \
		MESHD_UDP_LISTEN="$udp_listen" \
		MESHD_HOME_ID="$home_id" \
		MESHD_HOME_NAME="$home_name" \
		MESHD_CONTROLLER_ID="$controller_id" \
		MESHD_MESH_SSID="$mesh_ssid" \
		MESHD_MESH_KEY="$mesh_key" \
		MESHD_AUTO_ADOPT="$auto_adopt" \
		MESHD_CONTROLLER="$controller_url" \
		MESHD_IDENTITY_DIR="$identity_dir" \
		MESHD_SERIAL="$serial" \
		MESHD_BACKHAUL_IFACE="$backhaul_iface" \
		MESHD_LED="$led_enabled" \
		MESHD_LED_NAME="$led_name" \
		MESHD_AUTO_ONBOARD_WIRED="$auto_onboard_wired" \
		MESHD_ONBOARD_GRACE="$onboard_grace" \
		MESHD_MANAGE_NETWORK="$manage_network" \
		MESHD_UPLINK_PORT="$uplink_port" \
		MESHD_LAN_DEVICE="$lan_device"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
