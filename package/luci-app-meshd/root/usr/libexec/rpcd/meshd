#!/bin/sh
# rpcd exec plugin: exposes meshd's local management API as the `meshd` ubus
# object. rpcd registers this object and gates it with the ACL in
# /usr/share/rpcd/acl.d/luci-app-meshd.json, so LuCI's session authenticates
# every call — meshd itself stays unauthenticated behind localhost.
#
# Contract (OpenWrt rpcd exec protocol):
#   <plugin> list            -> JSON of {method: {arg: sample}}
#   <plugin> call <method>   -> request object on stdin, result JSON on stdout
#
# The method set mirrors the PWA's ubus transport (web/src/api/ubus.ts): each
# call proxies to meshd's HTTP API on $MESHD_URL (default localhost; overridden
# under test to point at a stub server).

MESHD_URL="${MESHD_URL:-http://127.0.0.1:8080}"

# Talk to meshd with busybox `nc` rather than curl: curl is not in OpenWrt's
# default image and pulling it needs a feed, which breaks offline installs.
# nc is always present (busybox), and meshd's API lives on localhost, so a
# plain HTTP/1.0 request is all we need. uclient-fetch/wget can't be used here
# because the API uses PUT/DELETE, which they don't support.
#
# Split MESHD_URL (http://host:port) into host/port for nc's positional args.
_hostport="${MESHD_URL#http://}"
_hostport="${_hostport%%/*}"
case "$_hostport" in
*:*) MESHD_HOST="${_hostport%%:*}"; MESHD_PORT="${_hostport##*:}" ;;
*)   MESHD_HOST="$_hostport"; MESHD_PORT=80 ;;
esac

# Strip the HTTP response headers, emitting only the body. Headers end at the
# first blank (CRLF) line; everything after it is meshd's JSON. We never gate
# on the status code: on an HTTP error meshd still returns a JSON
# `{"error":"..."}` body, and we want that body to flow back to the PWA (which
# surfaces data.error) so the user sees the real reason rather than a bare,
# meaningless ubus status (e.g. 5).
_strip_headers() { awk 'body{print;next} /^\r?$/{body=1}'; }

# http_req METHOD PATH BODY: issue one request and print meshd's response body.
# Connection: close makes meshd close the socket after responding, so nc reads
# the full response and exits cleanly. Content-Length is byte-counted (wc -c)
# so a multi-byte UTF-8 body (e.g. a home name) is framed correctly; without it
# Go's net/http treats the request as having no body.
#
# Once the request is written, nc's stdin hits EOF and busybox nc half-closes
# the socket. Go's http server reads that as the client going away and cancels
# the request context — so meshd must not tie its downstream `ubus` work to the
# request context (it doesn't; see internal/ubus.Call), or slow handlers would
# die with "context canceled". meshd can still write the response over the
# half-open socket, which nc reads here.
http_req() {
	{
		printf '%s %s HTTP/1.0\r\nHost: %s\r\nConnection: close\r\n' "$1" "$2" "$MESHD_HOST"
		if [ -n "$3" ]; then
			printf 'Content-Type: application/json\r\nContent-Length: %s\r\n' "$(printf '%s' "$3" | wc -c)"
		fi
		printf '\r\n'
		[ -n "$3" ] && printf '%s' "$3"
	} | nc "$MESHD_HOST" "$MESHD_PORT" | _strip_headers
}

get() { http_req GET "$1" ""; }
send() { http_req "$1" "$2" "$3"; }

# json_str extracts a flat string field ($1) from the JSON in $2. Deliberately
# avoids jshn so the plugin is portable and testable off-OpenWrt; meshd only
# passes simple {"home_id": "..."} style argument objects here.
json_str() { printf '%s' "$2" | sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'; }

case "$1" in
list)
	cat <<-'EOF'
		{
		  "status": {}, "topology": {}, "setup": {}, "complete_setup": {},
		  "homes": {}, "create_home": { "id": "", "name": "" },
		  "get_home": { "home_id": "" }, "update_home": { "home_id": "" },
		  "get_profile": { "home_id": "" }, "save_profile": { "home_id": "" },
		  "nodes": {}, "get_node": { "node_id": "" },
		  "adopt_node": { "node_id": "" }, "reject_node": { "node_id": "" },
		  "active_home": {}, "set_active_home": { "home_id": "" },
		  "home_selection": {}, "enrollments": {}, "scan": {},
		  "join_home": { "controller_url": "" },
		  "delete_home": { "home_id": "" }, "delete_node": { "node_id": "" },
		  "reset": {}
		}
	EOF
	;;
call)
	req="$(cat)"
	case "$2" in
	status)         get /status ;;
	topology)       get /topology ;;
	setup)          get /setup ;;
	complete_setup) send POST /setup/complete "$req" ;;
	homes)          get /homes ;;
	create_home)    send POST /homes "$req" ;;
	get_home)       get "/homes/$(json_str home_id "$req")" ;;
	update_home)    send PUT "/homes/$(json_str home_id "$req")" "$req" ;;
	get_profile)    get "/homes/$(json_str home_id "$req")/profile" ;;
	save_profile)   send POST "/homes/$(json_str home_id "$req")/profile" "$req" ;;
	nodes)          get /nodes ;;
	get_node)       get "/nodes/$(json_str node_id "$req")" ;;
	adopt_node)     send POST "/nodes/$(json_str node_id "$req")/adopt" "" ;;
	reject_node)    send POST "/nodes/$(json_str node_id "$req")/reject" "" ;;
	active_home)    get /active-home ;;
	set_active_home) send PUT /active-home "$req" ;;
	home_selection) get /home-selection ;;
	enrollments)    get /enroll ;;
	scan)           get /scan ;;
	join_home)      send POST /enroll/join "$req" ;;
	delete_home)    send DELETE "/homes/$(json_str home_id "$req")" "" ;;
	delete_node)    send DELETE "/nodes/$(json_str node_id "$req")" "" ;;
	reset)          send POST /reset "" ;;
	*)
		echo '{"error":"unknown method"}'
		exit 1
		;;
	esac
	;;
esac
