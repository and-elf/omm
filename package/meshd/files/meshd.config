config meshd 'main'
	option role 'controller'
	# Combined mode: both planes on one address. To run split listeners,
	# remove http_addr and uncomment mgmt_addr/mesh_addr below — the management
	# API then binds to localhost (reach it through LuCI) while the mesh control
	# plane stays on the network.
	option http_addr '0.0.0.0:8080'
	# option mgmt_addr '127.0.0.1:8080'
	# option mesh_addr '0.0.0.0:8081'
	option database_path '/etc/meshd/meshd.bolt'
	option udp_listen ':45678'
	# Home id. Leave empty to auto-derive a unique id from the device identity
	# (so multiple fresh devices never collide on a shared 'default-home', which
	# would make them invisible to each other's discovery). The wizard / companion
	# app sets a friendly id when you create or join a Home.
	option home_id ''
	option home_name 'Home'
	option controller_id 'gw01'
	# Default Home wireless, used to seed a profile when the Home has none yet so
	# onboarding pushes wifi without the wizard. Empty mesh_ssid derives a unique
	# name from the Home id; empty mesh_key generates a random one (stored in the
	# profile). The wizard / companion app overrides these.
	option mesh_ssid ''
	option mesh_key ''
	# When and how the controller auto-adopts enrolling nodes:
	#   off    - never; an operator approves each node (default, safest)
	#   onlink - auto-adopt only nodes enrolling from this controller's own LAN
	#            (physically on the home network) - recommended for a kit
	#   always - auto-adopt any node that enrolls, from anywhere (lab/test)
	# The decision is the controller's, gated on the verifiable request source -
	# never on the node's self-declared backhaul.
	option adopt_policy 'off'
	option identity_dir '/etc/meshd/identity'
	# Ethernet uplink interface used to classify this node's backhaul as wired
	# vs wireless in the topology graph. No universal default — set it per board
	# (e.g. 'eth0'). Empty => backhaul reported as unknown.
	option backhaul_iface ''
	# Status LED: blink while unclaimed, heartbeat while joining, solid once
	# active. The name is hardware-specific (see /sys/class/leds); an absent LED
	# is a no-op. Set led_enabled '0' to leave the LED alone.
	option led_enabled '1'
	option led_name 'green:status'
	# Auto-onboard an unclaimed node that is on the wire (ethernet backhaul) into
	# a discovered controller, unattended. Opt-in: requires backhaul_iface set,
	# and the controller to auto-adopt for the join to complete without approval.
	option auto_onboard_wired '0'
	# How long an unclaimed wired node lets discovery + auto-onboarding try to
	# enroll it into a controller before falling back to becoming its own
	# controller (Go duration, e.g. '20s', '1m'). Give discovery time to find a
	# controller on slower networks.
	option onboard_grace '20s'
	# Lifecycle network posture (see doc/network-posture.md): when enabled, an
	# unclaimed node takes a "Guest" dumb-AP posture — its wired uplink is bridged
	# into br-lan, it becomes a DHCP client, and its authoritative DHCP is stood
	# down — so it is L2-adjacent to a controller and can actually discover/scan
	# other homes (a routed, firewalled WAN drops the discovery broadcast). It
	# returns to a gateway posture once it controls its home. OFF by default: it
	# reconfigures the network and can strand a hand-wired device, so enable only
	# after verifying on the target board. uplink_port is the wired uplink device
	# bridged into br-lan; empty (default) auto-detects it from network.wan.device
	# so any ethernet jack works without per-board config — including a single-jack
	# AP whose only port is wired as 'wan'. lan_device is the UCI section of the
	# LAN bridge device (default '@device[0]').
	option manage_network '0'
	option uplink_port ''
	option lan_device '@device[0]'
