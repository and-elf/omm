# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Compiled meshd binary output
/bin/

# Packaging output (.ipk / .apk)
/build/

meshd-*.ipk
meshd-*.apk
meshd.bolt

# Signing secret keys — NEVER commit (public keys are committed in package/)
omm-feed.sec
omm-apk.key
private-key.pem
*.key.pem

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Frontend (PWA) build output and dependencies
/web/node_modules/
/web/dist/*
!/web/dist/.gitkeep
/web/coverage/
*.local

# Generated Capacitor native projects (regenerate with `npx cap add`; see
# doc/companion-app-packaging.md). Config, deps and scripts are committed.
/web/android/
/web/ios/

# Editor/IDE
# .idea/
# .vscode/
/meshd-identity/
