config meshd 'main'
	option role 'controller'
	# Combined mode: both planes on one address. To run split listeners,
	# remove http_addr and uncomment mgmt_addr/mesh_addr below — the management
	# API then binds to localhost (reach it through LuCI) while the mesh control
	# plane stays on the network.
	option http_addr '0.0.0.0:8080'
	# option mgmt_addr '127.0.0.1:8080'
	# option mesh_addr '0.0.0.0:8081'
	option database_path '/etc/meshd/meshd.bolt'
	option udp_listen ':45678'
	option home_id 'default-home'
	option home_name 'Home'
	option controller_id 'gw01'
	option auto_adopt '0'
	option identity_dir '/etc/meshd/identity'
	# Ethernet uplink interface used to classify this node's backhaul as wired
	# vs wireless in the topology graph. No universal default — set it per board
	# (e.g. 'eth0'). Empty => backhaul reported as unknown.
	option backhaul_iface ''
